--- a/src/core/game.c
+++ b/src/core/game.c
@@ -18,6 +18,7 @@
      * fade in, sound, animation */
     g->state = SR_ST_INTRO;
     g->want_song = -1;
+    g->last_game_song = -1;
     g->fade = SR_FADE_IN;
     g->fade_t = 0;
     sr_fb_clear(&g->fb, 0);
@@ -50,11 +51,22 @@
     g->paused = 0;
     g->tick = 0;
     if (!demo) {
-        /* gameplay music: random song 2..13, avoid repeating (main 0x29f) */
+        /* Gameplay music: random song 2..13, avoiding the previous GAMEPLAY
+         * song (main 0x29f-0x2c9).
+         *
+         * CORRECTED 2026-08-31 against the retail SKYROADS.EXE. main keeps the
+         * previous game index in its own slot at [bp-6] and compares `di`
+         * against that; the menus never touch it. Comparing against want_song
+         * instead is wrong, because enter_state sets want_song to 0 and 1 for
+         * the intro and the menus — so on the normal road -> menu -> road path
+         * want_song is 1 by the time a road starts, a gameplay song is never
+         * 1, and the dodge can never fire. The original never repeats a
+         * gameplay song back to back; this did. */
         g->rng = g->rng * 1103515245u + 12345u + (uint32_t)entry;
         int song = 2 + (int)((g->rng >> 16) % 12);
-        if (song == g->want_song)
+        if (song == g->last_game_song)
             song = 2 + (song - 1) % 12;
+        g->last_game_song = song;
         g->want_song = song;
     }
 }
--- a/src/core/game.h
+++ b/src/core/game.h
@@ -59,6 +59,8 @@
 
     /* audio requests consumed by the platform shell */
     int want_song;            /* -1 none; matches original song choices */
+    int last_game_song;       /* previous GAMEPLAY song (main [bp-6]);
+                                 menu songs must not disturb it */
     int sfx_request;          /* 0 none, else sfx index+1 */
     uint32_t rng;             /* music shuffle state */
 };
